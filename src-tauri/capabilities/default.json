{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the notch and settings windows",
  "windows": ["notch", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "ms-settings:privacy-notifications" }] },
    "autostart:default",
    "drag:default"
  ]
}
